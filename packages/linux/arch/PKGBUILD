# Maintainer: Aurora Browser <draftiermovie66@users.noreply.github.com>
# Contributor: Draftiermovie66 <draftiermovie66@users.noreply.github.com>
pkgname=aurora-browser
pkgver=2.0.6
pkgrel=1
pkgdesc='Chromium-based browser with self-contained profile, auto-update and custom new-tab page'
arch=('x86_64')
url='https://github.com/Draftiermovie66/Aurora-Browser'
license=('MIT')
depends=('curl' 'unzip' 'ca-certificates' 'hicolor-icon-theme' 'desktop-file-utils')
makedepends=('rsync')
optdepends=(
  'nodejs: rebuild the React new-tab extension from source'
  'npm: rebuild the React new-tab extension from source'
)
provides=('aurora-browser')
conflicts=('aurora-browser-git')
install=aurora-browser.install
source=()
sha256sums=()

# No remote source for local builds — package() stages directly from the
# repository tree. For AUR publishing, add:
#   source=("aurora-browser-${pkgver}.tar.gz::https://github.com/Draftiermovie66/Aurora-Browser/archive/refs/tags/v${pkgver}.tar.gz")
# and adjust package() to use "${srcdir}/Aurora-Browser-${pkgver}".

pkgver() {
  # Keep pkgver in sync with top-level VERSION when building from git
  if [ -f "${startdir}/../../VERSION" ]; then
    cat "${startdir}/../../VERSION"
  elif [ -f "${startdir}/VERSION" ]; then
    cat "${startdir}/VERSION"
  else
    echo "${pkgver}"
  fi
}

prepare() {
  # Ensure extension is built if node_modules is present (mirrors deb/rpm logic)
  local root="${startdir}/../.."
  # After reorg the root is packages/linux/arch → ../../.. ; try both
  [ -d "${root}/extension" ] || root="${startdir}/../../.."
  if [ -d "${root}/extension/node_modules" ] && [ -f "${root}/extension/package.json" ]; then
    msg "Building React new-tab extension..."
    (cd "${root}/extension" && npm run build)
  fi
}

package() {
  local root="${startdir}/../.."
  [ -d "${root}/extension" ] || root="${startdir}/../../.."
  # Fallback for new layout: packages/linux/arch → ../../..
  if [ ! -d "${root}/extension" ]; then
    root="${startdir}/../../.."
  fi
  # Ultimate fallback: startdir parent chain
  if [ ! -d "${root}/extension" ]; then
    root="$(cd "${startdir}/../.." && pwd)"
  fi

  local common="${root}/linux/common"
  [ -d "${common}" ] || common="${root}/packages/linux/common"
  local asset_icon="${root}/aurora.png"
  [ -f "${asset_icon}" ] || asset_icon="${root}/assets/icons/aurora.png"

  # Guard: fail fast if repo layout is unexpected
  if [ ! -f "${common}/launch.sh" ]; then
    error "Could not locate linux/common/launch.sh (tried ${common})"
    return 1
  fi

  # --- /opt/aurora-browser ---
  install -dm755 "${pkgdir}/opt/aurora-browser"
  install -Dm755 "${common}/launch.sh"        "${pkgdir}/opt/aurora-browser/launch-aurora.sh"
  install -Dm755 "${common}/update.sh"         "${pkgdir}/opt/aurora-browser/update.sh"
  install -Dm644 "${common}/update.conf"       "${pkgdir}/opt/aurora-browser/update.conf"
  install -Dm755 "${common}/setup-sandbox.sh"  "${pkgdir}/opt/aurora-browser/setup-sandbox.sh"
  echo "CHROMIUM_VERSION=0" > "${pkgdir}/opt/aurora-browser/version.txt"
  chmod 644 "${pkgdir}/opt/aurora-browser/version.txt"

  install -dm755 "${pkgdir}/opt/aurora-browser/profile"
  install -dm755 "${pkgdir}/opt/aurora-browser/extension"

  # Extension (exclude dev-only node_modules, keep built dist/)
  if [ -d "${root}/extension" ]; then
    rsync -a --exclude 'node_modules' "${root}/extension/" "${pkgdir}/opt/aurora-browser/extension/"
  fi

  # Mark engine/profile as ignored for pacman
  cat > "${pkgdir}/opt/aurora-browser/.gitignore" <<'GITIGNORE'
chrome-linux/
chrome-linux.old/
profile/
GITIGNORE

  # --- /usr/bin symlink ---
  install -dm755 "${pkgdir}/usr/bin"
  ln -s /opt/aurora-browser/launch-aurora.sh "${pkgdir}/usr/bin/aurora-browser"

  # --- .desktop ---
  install -dm755 "${pkgdir}/usr/share/applications"
  cat > "${pkgdir}/usr/share/applications/aurora-browser.desktop" <<'DESKTOP'
[Desktop Entry]
Name=Aurora Browser
Comment=Chromium-based browser with self-contained profile and auto-update
Exec=/opt/aurora-browser/launch-aurora.sh %U
Icon=aurora-browser
Terminal=false
Type=Application
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupWMClass=Aurora-Browser
DESKTOP

  # --- icons ---
  install -dm755 "${pkgdir}/usr/share/icons/hicolor/48x48/apps"
  install -dm755 "${pkgdir}/usr/share/icons/hicolor/256x256/apps"
  if [ -f "${asset_icon}" ]; then
    install -Dm644 "${asset_icon}" "${pkgdir}/usr/share/icons/hicolor/48x48/apps/aurora-browser.png"
    # Reuse 48px for 256px if no separate asset — desktop-file-utils handles scaling
    install -Dm644 "${asset_icon}" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/aurora-browser.png"
  fi
  # Also install to pixmaps for legacy DEs
  install -dm755 "${pkgdir}/usr/share/pixmaps"
  [ -f "${asset_icon}" ] && ln -s /usr/share/icons/hicolor/48x48/apps/aurora-browser.png "${pkgdir}/usr/share/pixmaps/aurora-browser.png" || true
}
