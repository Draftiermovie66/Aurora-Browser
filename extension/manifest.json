{
  "manifest_version": 3,
  "name": "Aurora New Tab",
  "version": "2.0.0",
  "description": "Aurora Browser landing page",
  "chrome_url_overrides": {
    "newtab": "dist/index.html"
  },
  "permissions": ["storage"],
  "web_accessible_resources": [
    {
      "resources": ["aurora.png"],
      "matches": ["<all_urls>"]
    }
  ]
}